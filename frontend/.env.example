# ==============================================================================
# Frontend Environment Configuration (Next.js)
# ==============================================================================
# NOTE: Only variables prefixed with NEXT_PUBLIC_ are bundled into client-side code.
# Never place database passwords, private API keys, or secret tokens here!

# Public API Gateway URL
# Local Development: http://localhost:8000/api
# Production: https://api.udyogsaarthi.in/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public Canonical Site Base URL
# Local Development: http://localhost:3000
# Production: https://udyogsaarthi.in
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile Public Site Key
# Official Cloudflare always-pass test site key: 1x00000000000000000000AA
# Replace with real Cloudflare site key in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Plausible Analytics (Cookieless, privacy-preserving)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=udyogsaarthi.in
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# Sentry Error Monitoring (Zero-PII Client-Side Monitoring)
# Leave blank to disable Sentry error reporting.
# When provided, all user emails, names, cookies, and tokens are scrubbed before transmission.
NEXT_PUBLIC_SENTRY_DSN=

# ==============================================================================
# Organization & Legal Compliance Metadata
# ==============================================================================
NEXT_PUBLIC_ORG_NAME=Udyog Saarthi Initiative
NEXT_PUBLIC_CONTACT_EMAIL=contact@udyogsaarthi.in
NEXT_PUBLIC_LEGAL_EMAIL=legal@udyogsaarthi.in
NEXT_PUBLIC_HELPLINE_PHONE=+91 11 2345 6789
NEXT_PUBLIC_POSTAL_ADDRESS=Department of Empowerment of Persons with Disabilities, 5th Floor, Pt. Deendayal Antyodaya Bhawan, CGO Complex, Lodhi Road, New Delhi 110003, India
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=Smt. Priya Sharma
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=grievance@udyogsaarthi.in
NEXT_PUBLIC_LEGAL_LAST_UPDATED=October 9, 2026
# Set to 'true' once platform legal review is officially signed off to remove the draft banner
NEXT_PUBLIC_LEGAL_REVIEWED=false
