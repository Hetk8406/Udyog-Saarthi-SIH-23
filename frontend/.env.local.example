# ==============================================================================
# Udyog Saarthi — Local Development Environment Configuration (frontend/.env.local)
# Uses the exact same 'localhost' hostname as the frontend to prevent cross-site cookie drops
# ==============================================================================

# Public API Base URL (Must match the same host as frontend e.g. localhost, NOT 127.0.0.1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public Canonical Site Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile Public Site Key
# Official Cloudflare test "Always Passes" sitekey: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Plausible Analytics (Optional in development)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=udyogsaarthi.in
NEXT_PUBLIC_PLAUSIBLE_API_HOST=https://plausible.io

# Client-Side Sentry (Leave blank for local dev)
NEXT_PUBLIC_SENTRY_DSN=
