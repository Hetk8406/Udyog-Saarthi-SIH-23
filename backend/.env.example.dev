# ==============================================================================
# Udyog Saarthi — Local Development Environment Configuration (backend/.env)
# Safe, frictionless defaults for local developer evaluation
# ==============================================================================

# Django Core Settings
SECRET_KEY=django-insecure-udyog-saarthi-dev-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=http://localhost:3000

# Database Configuration
# USE_SQLITE=True enables zero-dependency local SQLite development (db.sqlite3).
# Set USE_SQLITE=False if using local PostgreSQL.
USE_SQLITE=True
DB_NAME=udyog_saarthi
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Demo Seed Guard (Must be True to allow seed_demo_* commands and demo account logins)
ALLOW_DEMO_SEED=True

# CORS & CSRF Origins (Uses localhost:3000 to match frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie & Session Security (Dev-safe: COOKIE_SECURE=False enables HTTP on localhost)
COOKIE_DOMAIN=
COOKIE_SECURE=False
COOKIE_SAMESITE=Lax

# Cloudflare Turnstile Bot Protection
# Uses Cloudflare's official testing "Always Passes" dummy secret key for local development
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Email & Notifications (Prints emails to Django console terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_FROM="Udyog Saarthi Dev" <noreply@localhost>
EMAIL_REPLY_TO=support@localhost

# Asynchronous Tasks (Synchronous dispatch locally if Redis is not running)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_ALWAYS_EAGER=True

# AI Plain-Language Explainer (Leave blank for instant deterministic heuristic generator)
AI_ASSISTANT_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Private Document Storage (Uses secure local disk vault in development)
USE_S3_STORAGE=False

# SMS Provider (fake logs SMS messages to console terminal)
SMS_PROVIDER=fake
