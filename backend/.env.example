# ==============================================================================
# Django Core Settings
# ==============================================================================
# Generate a cryptographically secure 50+ character random key for production.
# In production (DEBUG=False), SECRET_KEY is mandatory and has NO default fallback.
SECRET_KEY=generate-a-secure-random-secret-key-for-production-min-50-chars

# Must be False in production! Set to True only for local developer testing.
DEBUG=False

# Comma-separated list of valid host/domain names that this Django site can serve.
ALLOWED_HOSTS=api.udyogsaarthi.in,udyogsaarthi.in,127.0.0.1,localhost

# Base URL of the Next.js frontend (used for password reset emails and redirects)
FRONTEND_BASE_URL=https://udyogsaarthi.in

# ==============================================================================
# Database Configuration (PostgreSQL Recommended for Production)
# ==============================================================================
DB_NAME=udyog_saarthi
DB_USER=udyog_admin
DB_PASSWORD=your_strong_database_password_here
DB_HOST=127.0.0.1
DB_PORT=5432

# Set to True for zero-dependency local SQLite development; False for PostgreSQL
USE_SQLITE=False

# ==============================================================================
# Demo Seed Guard (Must be True to allow seed_demo_* commands; strictly blocked if DEBUG=False)
# ==============================================================================
ALLOW_DEMO_SEED=False

# ==============================================================================
# CORS & Allowed Origins
# ==============================================================================
CORS_ALLOWED_ORIGINS=https://udyogsaarthi.in,http://localhost:3000

# ==============================================================================
# HTTPS & Cookie Security (Active when DEBUG=False)
# ==============================================================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
COOKIE_DOMAIN=
COOKIE_SECURE=True
COOKIE_SAMESITE=Lax

# ==============================================================================
# Email Backend Configuration (SMTP / Resend / Amazon SES)
# ==============================================================================
# Local development default: django.core.mail.backends.console.EmailBackend
# Production SMTP default: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server details (e.g., smtp.resend.com, email-smtp.ap-south-1.amazonaws.com, smtp.sendgrid.net)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# SMTP Credentials
# For Resend: EMAIL_HOST_USER=resend, EMAIL_HOST_PASSWORD=re_123456...
# For SES: EMAIL_HOST_USER=<SES_SMTP_USERNAME>, EMAIL_HOST_PASSWORD=<SES_SMTP_PASSWORD>
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=your-smtp-provider-password-or-api-key

# Sender & Reply Addresses
EMAIL_FROM="Udyog Saarthi" <noreply@udyogsaarthi.in>
EMAIL_REPLY_TO=support@udyogsaarthi.in

# ==============================================================================
# Celery & Redis Task Broker (Asynchronous email & background job processing)
# ==============================================================================
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
# When True, executes tasks synchronously in-process (convenient without Redis locally)
CELERY_ALWAYS_EAGER=False

# ==============================================================================
# AI Plain-Language Job Explainer (Google Gemini via Backend REST API)
# ==============================================================================
# Gemini API key is read ONLY on the backend; NEVER expose to client/frontend!
# Leave blank to use built-in heuristic plain-language generator with zero latency.
AI_ASSISTANT_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# ==============================================================================
# Private Object Storage (AWS S3 / MinIO / Cloudflare R2)
# ==============================================================================
# Set to True to enable private S3 storage with presigned URLs; False for local HMAC vault
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=udyog-saarthi-candidate-documents
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=

# ==============================================================================
# Cloudflare Turnstile Bot & Spam Protection
# ==============================================================================
# Test key (1x0000000000000000000000000000000AA) only allowed when DEBUG=True.
# Production (DEBUG=False) strictly requires a real Turnstile secret key and fails closed.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ==============================================================================
# SMS Service Provider (Pluggable: fake, msg91, twilio)
# ==============================================================================
# Default is 'fake' (logs OTPs and alerts to console/debug logs; safe for dev & testing)
SMS_PROVIDER=fake

# MSG91 Configuration (requires TRAI DLT registration in India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=UDYOGS
MSG91_DLT_TE_ID=1107161234567890123
MSG91_ROUTE=4

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ==============================================================================
# Sentry Error Monitoring & APM (Zero-PII)
# ==============================================================================
# Leave blank to disable Sentry. All candidate personal data, UDIDs, and passwords
# are automatically scrubbed via custom before_send hook before transmission.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
