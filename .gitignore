!backend/.env.example.dev
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example
!frontend/.env.local.example

# ==============================================================================
# Python & Django
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.sqlite3
*.db
