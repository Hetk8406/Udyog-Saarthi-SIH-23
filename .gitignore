# ==============================================================================
# Environment & Secret Files (NEVER COMMIT SENSITIVE KEYS)
# ==============================================================================
.env
.env.*
*.env
!.env.example
!.env.example.dev
!.env.local.example
!*.env.example
!*.env.example.*
backend/.env
backend/.env.*
